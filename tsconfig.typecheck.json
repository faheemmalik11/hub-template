// TYPECHECK-ONLY CONFIG. Run it with: npm run typecheck
//
// beside this app's. Two copies of the React types in one program make otherwise identical props
//
// The pin CANNOT live in tsconfig.json. vite-tsconfig-paths applies that file's paths at RUNTIME
// as well, so mapping "react" to the types package makes vite resolve the real React import to
// @types/react, which exports no ".". Every dev server dies on load with a vite-resolve error.
// That plugin only ever reads files named tsconfig.json or jsconfig.json, so this one is invisible
// to it and the pin stays type-only.
//
// "paths" is REPLACED by extends, never merged, so the whole map is repeated below. Any change to
// the paths in tsconfig.json must be mirrored here.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "lucide-react": [
        "./node_modules/lucide-react"
      ],
    }
  }
}
