# The bootstrap, and only this. Everything else a client configures is a row in their own
# database. Generated from src/config/env.ts by scripts/write-env-example.mjs.

# The client's Supabase project URL. `supabase start` prints it for local work.
VITE_SUPABASE_URL=

# That project's publishable (anon) key. Never the service-role key: this one reaches the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Names the local Docker containers. Only the Supabase CLI reads it, never the app.
SUPABASE_PROJECT_ID=hub_template

# Look at the screens with sample data and no database behind them. Leave this out of a client's
# .env: a Hub in seed mode shows invented figures, which must never be mistaken for theirs.
# VITE_SEED=1
