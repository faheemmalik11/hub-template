# The bootstrap, and only this. Everything else a client configures is a row in their own database.
#
# For local development, `supabase start` prints both values. For a real client, they are the
# project URL and the publishable (anon) key from that client's own Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Names the local Docker containers. Only needed for the Supabase CLI, never at run time.
SUPABASE_PROJECT_ID=hub_template
